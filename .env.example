# Copy to .env (or configure these in your MCP client config).
# Public tools work without a key; authenticated tools need one.

# ApeKey from https://monkeytype.com → Account → Ape Keys.
MONKEYTYPE_API_KEY=

# Default username/uid for get_profile / get_user_overview.
MONKEYTYPE_USERNAME=

# Optional overrides
# MONKEYTYPE_API_BASE_URL=https://api.monkeytype.com
# MONKEYTYPE_TIMEOUT_MS=30000
# MONKEYTYPE_MAX_RETRIES=2
# MONKEYTYPE_CACHE_TTL_MS=60000

# HTTP transport (only used with --transport http)
# MCP_PORT=3000
# MCP_HOST=127.0.0.1
