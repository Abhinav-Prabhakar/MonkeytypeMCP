{
  "name": "monkeytype-mcp-server",
  "version": "2.0.1",
  "description": "Model Context Protocol server for the Monkeytype API: profiles, results, stats, leaderboards and more, for any MCP client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "monkeytype",
    "typing",
    "wpm",
    "api",
    "llm",
    "ai",
    "claude",
    "cursor"
  ],
  "homepage": "https://github.com/Abhinav-Prabhakar/MonkeytypeMCP#readme",
  "bugs": {
    "url": "https://github.com/Abhinav-Prabhakar/MonkeytypeMCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhinav-Prabhakar/MonkeytypeMCP.git"
  },
  "license": "MIT",
  "author": "Abhinav Prabhakar <85114885+Abhinav-Prabhakar@users.noreply.github.com>",
  "mcpName": "io.github.Abhinav-Prabhakar/monkeytype-mcp",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "monkeytype-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
